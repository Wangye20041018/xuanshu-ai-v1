classDiagram
    class ChangeSet {
        +files: FilePatch[]
        +summary: string
    }
    class FilePatch {
        +path: string
        +content: string
        +mode: 'patch' | 'overwrite'
    }
    class DiffResult {
        +filesAffected: string[]
        +additions: number
        +deletions: number
        +diffText: string
        +estimatedRisk: 'L0'|'L1'|'L2'|'L3'
    }
    class Snapshot {
        +hash: string
        +createdAt: number
        +files: string[]
    }
    class SelfModifyCapabilities {
        +allowedRoots: string[]
        +blockedPaths: string[]
        +writeEnabled: boolean
    }

    class Whitelist {
        +isAllowed(path: string): boolean
        +riskLevel(path: string): 'L0'|'L1'|'L2'|'L3'
        +normalizeAndValidate(path: string): string
    }

    class SelfModifyService {
        -whitelist: Whitelist
        -modelManager: any
        +getCapabilities(): SelfModifyCapabilities
        +listFiles(dir?: string): FileInfo[]
        +readFile(path: string): FileContent
        +generate(requirement: string): Promise<ChangeSet>
        +previewDiff(changeSet: ChangeSet): DiffResult
        +apply(changeSet: ChangeSet): Promise<Snapshot>
        +rollback(snapshotHash: string): Promise<boolean>
        +listSnapshots(): Snapshot[]
        -snapshot(): Promise<string>
        -auditLog(entry: string): void
    }

    class SelfModifyIpc {
        +register(ipcMain: IpcMain, service: SelfModifyService): void
    }

    class SelfModifyStore {
        +state: 'idle'|'reading'|'generating'|'previewing'|'applying'|'done'|'error'
        +capabilities: SelfModifyCapabilities
        +diff: DiffResult | null
        +setCapabilities(c): void
        +run(requirement: string): Promise<void>
        +confirmApply(): Promise<void>
        +rollback(): Promise<void>
    }

    class SelfModifyPage {
        -store: SelfModifyStore
        +render(): JSX
    }
    class DiffViewer {
        +diff: DiffResult
        +onApprove(): void
        +onReject(): void
    }

    SelfModifyService --> Whitelist : uses
    SelfModifyService --> ChangeSet : produces
    SelfModifyService --> DiffResult : produces
    SelfModifyService --> Snapshot : produces
    SelfModifyIpc --> SelfModifyService : wraps
    SelfModifyStore --> SelfModifyService : invokes IPC
    SelfModifyPage --> SelfModifyStore : reads
    SelfModifyPage --> DiffViewer : renders
