# 玄枢AI — 环境变量模板
# 复制此文件为 .env.cloud 并填入实际值
# 注意: .env.cloud 已在 .gitignore 中排除，不会提交到版本控制

# 云端 API Key（用于云端推理模式）
XUANSHU_CLOUD_API_KEY=sk-your-api-key-here

# 云端 API 地址
XUANSHU_CLOUD_API_URL=https://api.xuanshu.ai/v1

# 云端模型名称
XUANSHU_CLOUD_MODEL_NAME=xuanshu-pro

# 语音服务密钥（可选）
XUANSHU_VOICE_API_KEY=

# 搜索服务密钥（可选）
XUANSHU_SEARCH_API_KEY=
