{
  "id": "browser_control",
  "name": "浏览器操控",
  "description": "打开URL、点击元素、填表、截图等浏览器自动化操作",
  "level": "simple",
  "triggers": ["浏览器", "打开网页", "截图网页", "填表", "点击", "URL", "网页"],
  "function_schema": {
    "name": "browser_control",
    "description": "控制浏览器执行打开URL、点击、填表等操作",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {"type": "string", "enum": ["open", "screenshot", "click", "fill", "execute_js"], "description": "浏览器操作类型"},
        "url": {"type": "string", "description": "目标URL"},
        "selector": {"type": "string", "description": "CSS选择器（click/fill 时使用）"},
        "value": {"type": "string", "description": "填入的值（fill 时使用）/ JS代码（execute_js 时使用）"}
      },
      "required": ["action"]
    }
  }
}
