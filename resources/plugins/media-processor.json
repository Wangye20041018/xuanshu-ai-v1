{
  "id": "media-processor",
  "name": "媒体处理",
  "description": "视频剪辑/音频处理/字幕生成（调用ffmpeg）",
  "level": "heavy",
  "triggers": ["视频", "音频", "剪辑", "字幕", "转码", "压缩视频", "提取音频", "ffmpeg"],
  "function_schema": {
    "name": "media_processor",
    "description": "媒体处理工具（ffmpeg封装）",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {"type": "string", "enum": ["info", "convert", "trim", "extract_audio", "compress", "concat"]},
        "input_path": {"type": "string"},
        "output_path": {"type": "string"},
        "start_time": {"type": "string", "description": "开始时间，如 00:01:30"},
        "duration": {"type": "string", "description": "时长，如 00:00:30"},
        "format": {"type": "string", "description": "目标格式，如 mp4/mp3/wav"}
      },
      "required": ["action", "input_path"]
    }
  }
}
