{
  "id": "db-tools",
  "name": "数据库",
  "description": "连接/查询SQLite/MySQL/PostgreSQL",
  "level": "simple",
  "triggers": ["数据库", "SQL", "查询", "SQLite", "MySQL", "PostgreSQL", "连接数据库"],
  "function_schema": {
    "name": "db_tools",
    "description": "数据库查询操作",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {"type": "string", "enum": ["query", "list_tables", "schema"]},
        "db_type": {"type": "string", "enum": ["sqlite", "mysql", "postgresql"]},
        "db_path": {"type": "string", "description": "SQLite文件路径或连接字符串"},
        "sql": {"type": "string", "description": "SQL查询语句"}
      },
      "required": ["action", "db_type"]
    }
  }
}
