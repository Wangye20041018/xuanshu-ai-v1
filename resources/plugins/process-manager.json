{
  "id": "process-manager",
  "name": "进程管理",
  "description": "列出/搜索/强杀/优先级调整",
  "level": "simple",
  "triggers": ["进程", "任务", "强杀", "结束进程", "CPU占用", "内存占用", "任务管理器"],
  "function_schema": {
    "name": "process_manager",
    "description": "管理运行中的进程",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {"type": "string", "enum": ["list", "search", "kill", "priority"]},
        "name": {"type": "string", "description": "进程名或关键词"},
        "pid": {"type": "integer", "description": "进程PID"}
      },
      "required": ["action"]
    }
  }
}
