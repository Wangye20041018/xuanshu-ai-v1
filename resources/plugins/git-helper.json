{
  "id": "git-helper",
  "name": "Git操作",
  "description": "status/log/diff/commit/push（简要）",
  "level": "simple",
  "triggers": ["git", "提交", "推送", "分支", "仓库", "commit", "push", "pull", "diff"],
  "function_schema": {
    "name": "git_helper",
    "description": "Git版本控制操作",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {"type": "string", "enum": ["status", "log", "diff", "commit", "push", "pull", "branch"]},
        "repo_path": {"type": "string", "description": "仓库路径"},
        "message": {"type": "string", "description": "提交信息"},
        "branch": {"type": "string"}
      },
      "required": ["action"]
    }
  }
}
